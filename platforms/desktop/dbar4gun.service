# dbar4gun como servicio en un Linux de escritorio.
#   sudo cp dbar4gun.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dbar4gun
# Ajustar la ruta de dbar4gun (la del venv donde se instalo) y las opciones.
[Unit]
Description=dbar4gun (Wiimote light gun)
After=bluetooth.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dbar4gun start --width 1920 --height 1080 --area full
Restart=on-failure

[Install]
WantedBy=multi-user.target
